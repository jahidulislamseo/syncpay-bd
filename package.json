{
  "name": "syncpay-bd",
  "version": "1.0.0",
  "description": "Self-hosted SMS-based payment automation engine for bKash, Nagad, Rocket, and Upay (SyncPay BD)",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "vercel-build": "tsc",
    "start": "node dist/index.js",
    "test": "node --test --import tsx tests/**/*.test.ts",
    "simulate": "tsx scripts/simulate-sms.ts"
  },
  "keywords": [
    "bkash",
    "nagad",
    "rocket",
    "upay",
    "payment-automation",
    "bangladesh",
    "syncpay"
  ],
  "author": "SyncPay BD",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^8.1.1",
    "@supabase/supabase-js": "^2.116.0",
    "@types/pg": "^8.23.1",
    "fastify": "^5.2.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
