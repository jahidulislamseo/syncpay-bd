{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/:path*",      "destination": "/api/index.js" },
    { "source": "/api",             "destination": "/api/index.js" },
    { "source": "/pay/:slug*",      "destination": "/checkout.html" },
    { "source": "/checkout/:slug*", "destination": "/checkout.html" },
    { "source": "/app",             "destination": "/download.html" }
  ]
}




