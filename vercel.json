{
  "version": 2,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/api", "destination": "/api/index.js" },
    { "source": "/health", "destination": "/api/index.js" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/checkout", "destination": "/checkout.html" },
    { "source": "/checkout/:slug*", "destination": "/checkout.html" },
    { "source": "/pay/:slug*", "destination": "/checkout.html" },
    { "source": "/app", "destination": "/download.html" },
    { "source": "/download", "destination": "/download.html" },
    { "source": "/docs/:slug", "destination": "/docs/:slug.html" }
  ]
}
