{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.syncpaybd.site"
        }
      ],
      "destination": "https://syncpaybd.site/$1",
      "permanent": true
    }
  ],
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/api", "dest": "/api/index.js" },
    { "src": "/app", "dest": "/public/download.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
