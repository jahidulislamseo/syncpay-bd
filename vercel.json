{
  "version": 2,
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.syncpaybd.site" }],
      "destination": "https://syncpaybd.site/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/api",        "destination": "/api/index.js" },
    { "source": "/health",     "destination": "/api/index.js" },
    { "source": "/login",                   "destination": "/login.html" },
    { "source": "/dashboard",               "destination": "/dashboard.html" },
    { "source": "/admin",                   "destination": "/admin.html" },
    { "source": "/checkout",                "destination": "/checkout.html" },
    { "source": "/checkout/:slug*",         "destination": "/checkout.html" },
    { "source": "/pay/:slug*",              "destination": "/checkout.html" },
    { "source": "/app",                     "destination": "/download.html" },
    { "source": "/download",               "destination": "/download.html" },
    { "source": "/docs/api",               "destination": "/docs/api.html" },
    { "source": "/docs/trx-verification",  "destination": "/docs/trx-verification.html" },
    { "source": "/docs/webhook",           "destination": "/docs/webhook.html" }
  ]
}

